{
  "id": "memory-milvus",
  "activation": {
    "onStartup": false
  },
  "kind": "memory",
  "commandAliases": [
      { "name": "memory-migrate" },
      { "name": "milvus-dreaming", "kind": "runtime-slash" }
    ],
  "contracts": {
    "tools": ["memory_write", "memory_get", "memory_search"]
  },
  "uiHints": {
    "milvus.host": {
      "label": "Milvus Host",
      "placeholder": "localhost",
      "help": "Milvus server hostname or IP address"
    },
    "milvus.port": {
      "label": "Milvus Port",
      "placeholder": "19530",
      "help": "Milvus server gRPC port"
    },
    "milvus.collectionName": {
      "label": "Collection Name",
      "placeholder": "openclaw_memory",
      "help": "Milvus collection name for memory storage",
      "advanced": true
    },
    "embedding.provider": {
      "label": "Embedding Provider",
      "placeholder": "alibaba",
      "help": "Memory embedding provider adapter to use"
    },
    "embedding.model": {
      "label": "Embedding Model",
      "placeholder": "text-embedding-v3",
      "help": "Embedding model name (1024-dimensional)"
    },
    "embedding.dimensions": {
      "label": "Embedding Dimensions",
      "placeholder": "1024",
      "help": "Vector dimensions for the embedding model",
      "advanced": true
    },
    "search.useBM25": {
      "label": "Use BM25",
      "help": "Enable Milvus BM25 sparse hybrid search on compatible deployments",
      "advanced": true
    },
    "search.vectorWeight": {
      "label": "Vector Weight",
      "placeholder": "0.7",
      "help": "Weight for dense vector similarity during result fusion",
      "advanced": true
    },
    "search.textWeight": {
      "label": "Text Weight",
      "placeholder": "0.3",
      "help": "Weight for text relevance during result fusion",
      "advanced": true
    },
    "index.metricType": {
      "label": "Vector Metric",
      "placeholder": "COSINE",
      "help": "Metric type for the dense vector index",
      "advanced": true
    },
    "index.hnswM": {
      "label": "HNSW M",
      "placeholder": "16",
      "help": "HNSW M parameter for the dense vector index",
      "advanced": true
    },
    "index.efConstruction": {
      "label": "HNSW efConstruction",
      "placeholder": "200",
      "help": "HNSW efConstruction parameter for index build quality",
      "advanced": true
    },
    "dreaming.enabled": {
      "label": "Dreaming Enabled",
      "help": "Enable scheduled short-term-to-long-term memory promotion via Milvus dreaming"
    },
    "dreaming.cron": {
      "label": "Dreaming Schedule",
      "placeholder": "0 3 * * *",
      "help": "Cron expression for the dreaming sweep cadence"
    },
    "dreaming.limit": {
      "label": "Promotion Limit",
      "placeholder": "5",
      "help": "Max short-term memories to promote per dreaming sweep"
    },
    "dreaming.minScore": {
      "label": "Min Promotion Score",
      "placeholder": "0.3",
      "help": "Minimum composite score (0-1) for a short-term memory to be promoted"
    },
    "dreaming.minRecallCount": {
      "label": "Min Recall Count",
      "placeholder": "2",
      "help": "Minimum recall count for a short-term memory to be a promotion candidate"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "milvus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "number",
            "minimum": 1,
            "maximum": 65535
          },
          "collectionName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "ssl": {
            "type": "boolean"
          },
          "database": {
            "type": "string"
          }
        }
      },
      "embedding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "dimensions": {
            "type": "number",
            "minimum": 128,
            "maximum": 8192
          }
        }
      },
      "search": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vectorWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "textWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "useBM25": {
            "type": "boolean"
          }
        }
      },
      "index": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metricType": {
            "type": "string",
            "enum": ["COSINE", "IP", "L2"]
          },
          "hnswM": {
            "type": "number",
            "minimum": 4,
            "maximum": 128
          },
          "efConstruction": {
            "type": "number",
            "minimum": 8,
            "maximum": 1024
          }
        }
      },
      "dreaming": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "cron": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "limit": {
            "type": "number",
            "minimum": 0
          },
          "minScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minRecallCount": {
            "type": "number",
            "minimum": 0
          },
          "minUniqueQueries": {
            "type": "number",
            "minimum": 0
          },
          "recencyHalfLifeDays": {
            "type": "number",
            "minimum": 1
          },
          "maxAgeDays": {
            "type": "number",
            "minimum": 1
          },
          "verboseLogging": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
